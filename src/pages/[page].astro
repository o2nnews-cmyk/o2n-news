---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Layout } from '@theme';

// Static pages managed in the admin panel (About, Contact, Privacy…).
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="container">
    <header class="page-head page-head--narrow">
      <h1 class="page-head__title">{entry.data.title}</h1>
      {entry.data.description && <p class="page-head__desc">{entry.data.description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>
