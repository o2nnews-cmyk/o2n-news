---
import { Layout } from '@theme';
import WebStoryCard from '../../components/WebStoryCard.astro';
import { getWebStories } from '../../lib/content';
import { t } from '../../lib/i18n';

const stories = await getWebStories();
---

<Layout title={t('webStories')} description={t('webStoriesDesc')} activeNav="webstories">
  <div class="container">
    <header class="page-head">
      <p class="page-head__eyebrow">{t('webStory')}</p>
      <h1 class="page-head__title">{t('webStories')}</h1>
      <p class="page-head__desc">{t('webStoriesDesc')}</p>
    </header>
    {
      stories.length ? (
        <div class="ws-grid">
          {stories.map((s, i) => (
            <WebStoryCard story={s} eager={i < 4} />
          ))}
        </div>
      ) : (
        <p class="empty">{t('noStories')}</p>
      )
    }
  </div>
</Layout>
