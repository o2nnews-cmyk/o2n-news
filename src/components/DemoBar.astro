---
// Shown only in the theme demos on the Ananta Newz website (showcase/build.mjs builds them with PUBLIC_DEMO=1).
// It lets a visitor go back to all themes, or ask for this theme on WhatsApp.
const demo = import.meta.env.PUBLIC_DEMO;
const theme = import.meta.env.PUBLIC_DEMO_THEME ?? '';
const whatsapp = import.meta.env.PUBLIC_DEMO_WA;
const waHref = whatsapp
  ? `https://wa.me/${whatsapp}?text=${encodeURIComponent(`नमस्ते Ananta Newz, मुझे "${theme}" थीम वाला न्यूज़ पोर्टल चाहिए।`)}`
  : undefined;
---

{
  demo && (
    <div class="demobar" role="region" aria-label="थीम डेमो">
      <a class="demobar__back" href="/#themes">← सभी थीम</a>
      <span class="demobar__text">
        आप <b>{theme}</b> थीम का डेमो देख रहे हैं
      </span>
      {waHref && (
        <a class="demobar__cta" href={waHref} target="_blank" rel="noopener">
          यह थीम चाहिए
        </a>
      )}
    </div>
  )
}

<style>
  .demobar {
    position: relative;
    z-index: 90;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 18px;
    padding: 7px 16px;
    background: #10131a;
    color: #eef0f4;
    font: 600 14px/1.3 'Mukta', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .demobar a {
    color: inherit;
  }

  .demobar__back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .demobar__cta {
    padding: 4px 12px;
    border-radius: 999px;
    background: #1fa855;
  }

  .demobar__cta:hover {
    background: #15803d;
  }

  @media (max-width: 560px) {
    .demobar__text {
      display: none;
    }
  }
</style>
