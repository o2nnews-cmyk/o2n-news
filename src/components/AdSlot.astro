---
// Ads added in the admin panel (Settings → विज्ञापन), shown in fixed places on every theme.
// Any image size works: it is centred and never wider than its column. An ad can also be HTML code
// from an ad network (e.g. Google AdSense) instead of an image.
import { t } from '../lib/i18n';
import { asset } from '../lib/url';

type Place = 'top' | 'home' | 'story' | 'after-story' | 'sidebar' | 'bottom';
type Ad = { name?: string; active?: boolean; placement?: string; order?: number | null; slide?: boolean; image?: string; link?: string; code?: string };

interface Props {
  place: Place;
  class?: string;
}

const { place, class: className } = Astro.props;

// Older client sites may not have the ads file yet; then there are simply no ads.
const files = import.meta.glob<{ ads?: Ad[] }>('../data/ads.json', { eager: true, import: 'default' });
const all = Object.values(files)[0]?.ads ?? [];
// Ads in the same place are shown in the order typed in the admin (blank = last, then the list order).
const ads = all
  .filter((ad) => ad && ad.active !== false && ad.placement === place && (ad.image || ad.code?.trim()))
  .map((ad, i) => ({ ad, i, order: typeof ad.order === 'number' ? ad.order : Number.POSITIVE_INFINITY }))
  .sort((a, b) => a.order - b.order || a.i - b.i)
  .map(({ ad }) => ad);

// "स्लाइड शो" on any ad in this place turns the whole place into one rotating slide (site.ts runs it).
const slide = ads.length > 1 && ads.some((ad) => ad.slide);
---

{
  ads.length > 0 && (
    <aside
      class:list={['ad-slot', `ad-slot--${place}`, { 'ad-slot--slide': slide }, className]}
      aria-label={t('advertisement')}
      data-slide={slide ? '' : undefined}
      data-pagefind-ignore
    >
      {ads.map((ad) => (
        <div class="ad">
          <span class="ad__label">{t('advertisement')}</span>
          {ad.code?.trim() ? (
            <div class="ad__code" set:html={ad.code} />
          ) : ad.link ? (
            <a href={ad.link} target="_blank" rel="sponsored noopener">
              <img src={asset(ad.image!)} alt={ad.name ?? t('advertisement')} loading={place === 'top' ? 'eager' : 'lazy'} decoding="async" />
            </a>
          ) : (
            <img src={asset(ad.image!)} alt={ad.name ?? t('advertisement')} loading={place === 'top' ? 'eager' : 'lazy'} decoding="async" />
          )}
        </div>
      ))}
    </aside>
  )
}
