---
// Shared <head> content (SEO, social cards, app manifest, theme boot script) used by every theme Layout.
import { settings } from '../lib/content';
import { url } from '../lib/url';
import type { HeadProps } from '../lib/types';

type Props = HeadProps;

const {
  title,
  description = settings.description,
  image = url('og-default.png'),
  type = 'website',
  noindex = false,
  jsonLd,
  preconnectYouTube = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${settings.site_title}` : `${settings.site_title} — ${settings.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || import.meta.env.PUBLIC_DEMO) && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.site_title} />
<meta property="og:title" content={title ?? settings.site_title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={(settings.locale || 'en_US').replace('-', '_')} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="manifest" href={url('manifest.webmanifest')} />
<link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content={settings.site_title} />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<link rel="alternate" type="application/rss+xml" title={settings.site_title} href={url('rss.xml')} />
<link rel="sitemap" href={url('sitemap-index.xml')} />
{preconnectYouTube && <link rel="preconnect" href="https://i.ytimg.com" />}
<meta name="generator" content={Astro.generator} />
<script is:inline>
  try {
    const t = localStorage.getItem('theme');
    if (t) document.documentElement.dataset.theme = t;
  } catch {}
</script>
{ld && <script type="application/ld+json" set:html={ld} />}
