---
import QRCode from 'qrcode';
import Icon from '../Icon.astro';
import { settings } from '../../lib/content';
import { t } from '../../lib/i18n';

// UPI donations with no payment gateway: the QR code is generated at build time from the UPI ID in Site settings.
const donate = (settings as { donate?: { upi_id?: string; payee_name?: string; note?: string } }).donate ?? {};
const upiId = donate.upi_id?.trim();
const uri = upiId
  ? `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent(donate.payee_name || settings.site_title)}&cu=INR`
  : '';
const qr = uri ? await QRCode.toString(uri, { type: 'svg', margin: 1, color: { dark: '#111111', light: '#ffffff' } }) : '';
---

{
  upiId && (
    <section class="w-card w-donate">
      <h2 class="w-card__title">
        <Icon name="heart" size={18} />
        {t('donate')}
      </h2>
      <p class="w-donate__text">{donate.note || t('donateText')}</p>
      <div class="w-donate__qr" set:html={qr} />
      <p class="w-donate__hint">{t('scanToPay')}</p>
      <code class="w-donate__id">{upiId}</code>
      <a class="btn btn--brand" href={uri}>
        {t('payUpi')}
      </a>
    </section>
  )
}
