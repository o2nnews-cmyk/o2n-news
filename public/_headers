# Cloudflare Pages / Netlify response headers

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# Hashed build assets never change — cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be re-checked so app updates reach readers.
/sw.js
  Cache-Control: no-cache

# The Android app (APK) offered on the website.
/download/*
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment

/.well-known/assetlinks.json
  Content-Type: application/json

/pagefind/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# Story data for the Android app (read from inside the app, so it must allow other origins).
/app/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60

/admin/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
